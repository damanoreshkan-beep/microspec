      "id": "wifi.scan",
      "capability": "wifi",
      "kind": "call",
      "minBridge": 4,
      "android": [
        "ACCESS_WIFI_STATE",
        "ACCESS_FINE_LOCATION"
      ],
      "summary": "Nearby networks. No web API exists for this in any browser. Android throttles scans hard (4 per 2 minutes in the foreground) and returns the LAST results when it refuses, so a caller must not read a repeat as movement.",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "networks"
