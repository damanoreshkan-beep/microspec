        "additionalProperties": false,
        "properties": {
          "networks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rssi"
              ],
              "additionalProperties": false,
              "properties": {
                "ssid": {
                  "type": "string"
                },
                "bssid": {
                  "type": "string"
                },
                "rssi": {
                  "type": "integer",
                  "description": "dBm."
                },
                "freq": {
                  "type": "integer",
                  "description": "MHz."
                },
                "caps": {
                  "type": "string",
                  "description": "Security capabilities as the driver reports them."
                },
                "ftm": {
                  "type": "boolean",
                  "description": "is80211mcResponder — this AP answers a Wi-Fi RTT ranging request, which is the only REAL distance any radio on this phone can produce (Android documents 1-2 m). False on most home routers, so a screen must never offer ranging until a scan has said true."
                },
                "std": {
                  "type": "integer",
                  "description": "getWifiStandard — 1 legacy, 4 11n, 5 11ac, 6 11ax, 8 11be. API 30+, absent below it."
                },
                "width": {
                  "type": "integer",
                  "description": "channelWidth — 0 is 20MHz, 1 is 40, 2 is 80, 3 is 160, 4 is 80+80, 5 is 320. API 23+."
                },
                "at": {
                  "type": "integer",
                  "description": "ScanResult.timestamp in microseconds since boot. A scan is a statement about WHEN; without it a throttled repeat is indistinguishable from a fresh look."
                }
              }
            }
          },
          "throttled": {
            "type": "boolean",
            "description": "The OS refused a fresh scan; these are the previous results."
          }
        }
      },
