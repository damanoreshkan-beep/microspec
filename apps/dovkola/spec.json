{
  "id": "dovkola",
  "theme": "signal",
  "category": "hackrf",
  "accent": "#2DD4BF",
  "fav": { "key": "id" },
  "detail": {
    "title": "name",
    "subtitle": "detail",
    "view": "signalDetail",
    "rows": [
      { "field": "bandLabel", "label": "rowBand", "icon": "lucide:radio-tower" },
      { "field": "freqLabel", "label": "rowFreq", "icon": "lucide:activity" },
      { "field": "payload", "label": "rowPayload", "icon": "lucide:file-text" },
      { "field": "countLabel", "label": "rowSeen", "icon": "lucide:repeat" },
      { "field": "firstSeen", "label": "rowFirst", "icon": "lucide:calendar-clock", "format": "since" },
      { "field": "lastSeen", "label": "rowLastHeard", "icon": "lucide:clock", "format": "since" }
    ]
  },
  "tabs": [
    {
      "id": "live",
      "type": "list",
      "icon": "lucide:radar",
      "label": "tabLive",
      "search": true,
      "searchKey": "search",
      "statusKey": "status",
      "sort": [
        { "key": "count", "label": "sortCount", "by": "count", "dir": "desc" },
        { "key": "strength", "label": "sortStrength", "by": "strength", "dir": "desc" },
        { "key": "recent", "label": "sortRecent", "by": "lastSeen", "dir": "desc" }
      ],
      "toggles": [
        { "key": "fm", "label": "scanFm", "icon": "lucide:radio" },
        { "key": "b433", "label": "scan433", "icon": "lucide:radio-tower" },
        { "key": "cell", "label": "scanCell", "icon": "lucide:antenna" },
        { "key": "wifi", "label": "scanWifi", "icon": "lucide:wifi" }
      ],
      "sections": [
        { "filter": "g_wifi", "icon": "lucide:wifi", "label": "grpWifi", "collapsible": true },
        { "filter": "g_bt", "icon": "lucide:bluetooth", "label": "grpBt", "collapsible": true },
        { "filter": "g_fm", "icon": "lucide:radio", "label": "grpFm", "collapsible": true },
        { "filter": "g_gsm", "icon": "lucide:antenna", "label": "grpGsm", "collapsible": true },
        { "filter": "g_ism", "icon": "lucide:radio-tower", "label": "grpIsm", "collapsible": true },
        { "filter": "g_ads", "icon": "lucide:plane", "label": "grpAds", "collapsible": true },
        { "filter": "g_other", "icon": "lucide:signal", "label": "grpOther", "collapsible": true }
      ],
      "empty": { "icon": "lucide:radio", "text": "empty", "hint": "emptyHint" },
      "card": {
        "layout": "table",
        "columns": [
          { "field": "name", "label": "colName", "grow": true, "lg": true, "sub": "detail" },
          { "field": "payload", "label": "colData", "grow": true, "muted": true },
          { "field": "countLabel", "label": "colSeen", "align": "right", "mono": true, "heat": "strength" },
          { "field": "lastSeen", "label": "colWhen", "align": "right", "mono": true, "muted": true, "format": "since" }
        ]
      }
    },
    {
      "id": "space",
      "type": "tool",
      "icon": "lucide:orbit",
      "label": "tabSpace",
      "titleKey": "tabSpace",
      "view": "space"
    },
    {
      "id": "saved",
      "type": "list",
      "icon": "lucide:bookmark",
      "label": "tabSaved",
      "titleKey": "tabSaved",
      "source": "fav",
      "search": true,
      "searchKey": "searchSaved",
      "empty": { "icon": "lucide:bookmark", "text": "emptySaved", "hint": "emptySavedHint" },
      "card": {
        "layout": "table",
        "columns": [
          { "field": "name", "label": "colName", "grow": true, "lg": true, "sub": "detail" },
          { "field": "payload", "label": "colData", "grow": true, "muted": true },
          { "field": "countLabel", "label": "colSeen", "align": "right", "mono": true, "heat": "strength" },
          { "field": "lastSeen", "label": "colWhen", "align": "right", "mono": true, "muted": true, "format": "since" }
        ]
      }
    },
    {
      "id": "me",
      "type": "profile",
      "icon": "lucide:user",
      "label": "tabMe",
      "titleKey": "tabMe"
    }
  ],
  "profile": {
    "icon": "lucide:radar",
    "theme": true,
    "lang": true,
    "install": true,
    "permissions": ["geolocation"]
  }
}
