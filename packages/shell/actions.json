    {
      "id": "lan.scan",
      "capability": "lan",
      "kind": "subscribe",
      "minBridge": 22,
      "android": [
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "summary": "Who else is on this network. A browser has no raw sockets, no ARP and no way to probe an unknown host, so this exists nowhere on the web. FIVE independent sources, because ports alone found only the router on a real network: UDP to a closed port (the host answers ICMP unreachable — it proves itself BY refusing, which is how a firewalled laptop is found at all), /system/bin/ping (isReachable falls back to TCP port 7 and ignores its own timeout), a TCP connect sweep, and SSDP + mDNS multicast, whose replies identify a host by the address they come from. Reverse DNS names whatever answered.",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ip": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Reverse DNS, or the SSDP SERVER line. Often absent — a bare address is an honest answer."
          },
          "ports": {
            "type": "string",
            "description": "Comma-separated open ports. EMPTY means it answered a ping but opened nothing, which is still a host."
          },
          "via": {
            "type": "string",
            "description": "udp | ping | tcp | ssdp | mdns — which source saw it. A host usually arrives more than once."
          },
          "at": {
            "type": "integer"
          },
          "done": {
            "type": "boolean",
            "description": "The sweep finished. A radio scan never does, so without this the list just stops growing and nothing says whether it is over."
          },
          "scanned": {
            "type": "integer"
          },
          "found": {
            "type": "integer"
          },
          "started": {
            "type": "boolean"
          },
          "ack": {
            "type": "boolean"
          },
          "progress": {
            "type": "boolean",
            "description": "The sweep is partway through. Fifteen seconds of nothing reads as broken."
          },
          "total": {
            "type": "integer"
          },
          "sources": {
            "type": "string",
            "description": "Per-probe tally, e.g. tcp=1 udp=4 ping=6 ssdp=2 mdns=3. A bare host count cannot say WHICH probe is dead."
          }
        }
      },
      "mock": {
        "ip": "192.168.1.1",
        "name": "router.lan",
        "ports": "80,443",
        "via": "tcp",
        "at": 1893479400000
      }
    }
