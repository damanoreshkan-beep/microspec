    {
      "id": "ble.scan",
      "capability": "ble",
      "kind": "subscribe",
      "minBridge": 6,
      "android": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ],
      "summary": "Every advertising device around you, as they appear. Web Bluetooth shows a chooser and returns the ONE device the user picks — it can never enumerate, which is exactly what a scanner needs.",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "result": {
        "type": "object",
        "required": [
          "addr"
        ],
        "additionalProperties": false,
        "properties": {
          "addr": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rssi": {
            "type": "integer"
          },
          "at": {
            "type": "integer"
          },
          "started": {
            "type": "boolean",
            "description": "Emitted once when startScan returned without throwing. Without it, a scan that never began and a scan that found nothing are the same empty screen."
          },
          "ack": {
            "type": "boolean",
            "description": "The bridge received the subscribe call, emitted before any logic runs — so a call that never arrived stops looking like one that was swallowed."
          },
          "raw": {
            "type": "string",
            "description": "The complete advertisement as lowercase hex. CANONICAL: a reduced schema cannot classify a protocol invented after this catalogue was written, and Android's own parser drops malformed structures. Absent on a shell older than bridge 24, which is how a page tells the difference between 'no payload' and 'this shell cannot send one'."
          },
          "tx": {
            "type": "integer",
            "description": "Advertised transmit power in dBm (AD type 0x0A, or getTxPower on extended advertising). Absent means not advertised — it must NOT be defaulted, because an assumed reference power at 1 m is where an RSSI distance estimate becomes fiction."
          },
          "tns": {
            "type": "integer",
            "description": "getTimestampNanos — monotonic since boot. Ordering and inter-advertisement intervals survive a wall-clock adjustment; `at` does not."
          },
          "sid": {
            "type": "integer",
            "description": "Advertising SID, 0-15, extended advertising only. A fingerprint clue WITHIN one address epoch — never a durable identity."
          },
          "dstat": {
            "type": "integer",
            "description": "getDataStatus — 0 complete, 1 truncated, 2 more-to-come. Parsing `raw` without checking this reads a fragment as a whole advertisement."
          },
          "legacy": {
            "type": "boolean"
          },
          "conn": {
            "type": "boolean",
            "description": "Connectable. The non-owner GATT service (identify, play sound, disablement instructions) is only reachable when this is true."
          }
        }
