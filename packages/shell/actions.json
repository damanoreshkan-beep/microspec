      "android": [
        "RECEIVE_BOOT_COMPLETED"
      ],
      "summary": "Fire a notification at a wall-clock time, offline, with the app closed — and again after a reboot. The web cannot do this at all since Notification Triggers was abandoned; it is the reason the APK exists.",
      "args": {
        "type": "object",
        "required": [
          "id",
          "at",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Yours to choose; setting the same id again replaces that alarm."
          },
          "at": {
            "type": "integer",
            "description": "Epoch milliseconds. In the past = fire now."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "result": {
        "type": "object",
        "required": [
          "id",
          "at",
          "exact"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "integer"
          },
          "exact": {
            "type": "boolean",
            "description": "False when the OS would only take an inexact alarm — Doze may shift it by minutes, and a screen that promises a time must say so."
          }
        }
      },
      "mock": {
