{
  "id": "homin",
  "theme": "signal",
  "category": "hackrf",
  "accent": "#E9A23B",
  "fav": { "key": "id" },
  "detail": {
    "title": "name",
    "subtitle": "detail",
    "rows": [
      { "icon": "lucide:radio-tower", "label": "rowChannel", "field": "channelLabel" },
      { "icon": "lucide:activity", "label": "rowFreq", "field": "freqLabel" },
      { "icon": "lucide:waveform", "label": "rowKind", "field": "kindLabel" },
      { "icon": "lucide:key-round", "label": "rowTone", "field": "toneLabel" },
      { "icon": "lucide:repeat", "label": "rowSeen", "field": "countLabel" },
      { "icon": "lucide:clock", "label": "rowLast", "field": "lastSeen", "format": "since" }
    ]
  },
  "tabs": [
    {
      "id": "band",
      "type": "tool",
      "icon": "lucide:radar",
      "label": "tabBand",
      "titleKey": "title",
      "view": "band",
      "fit": true,
      "needs": ["compass", "haptic"]
    },
    {
      "id": "saved",
      "type": "list",
      "icon": "lucide:bookmark",
      "label": "tabSaved",
      "titleKey": "tabSaved",
      "source": "fav",
      "search": true,
      "searchKey": "searchSaved",
      "empty": { "icon": "lucide:bookmark", "text": "emptySaved", "hint": "emptySavedHint" },
      "card": {
        "layout": "table",
        "columns": [
          { "field": "name", "label": "colName", "grow": true, "lg": true, "sub": "detail" },
          { "field": "channelLabel", "label": "colChannel", "align": "right", "mono": true },
          { "field": "lastSeen", "label": "colWhen", "align": "right", "mono": true, "muted": true, "format": "since" }
        ]
      }
    },
    {
      "id": "me",
      "type": "profile",
      "icon": "lucide:user",
      "label": "tabMe",
      "titleKey": "tabMe"
    }
  ],
  "profile": {
    "icon": "lucide:radar",
    "theme": true,
    "lang": true,
    "install": true
  }
}
