{
  "id": "weather",
  "theme": "signal",
  "category": "science",
  "accent": "#38BDF8",
  "tabs": [
    {
      "id": "now",
      "type": "dashboard",
      "icon": "lucide:sun",
      "label": "tabNow",
      "needs": ["geo"],
      "stage": {
        "shader": "hero.wgsl",
        "seed": "moon",
        "vary": ["skyAlt", "skyCloud", "skyWet", "skyWind"],
        "ink": ["skySnow", "skyHaze", "skyStorm", "skyLight"]
      },
      "hero": {
        "place": "place",
        "live": true,
        "icon": "wicon",
        "value": "temp",
        "unit": "°",
        "caption": "cond",
        "metrics": [
          { "field": "feels", "label": "mFeels", "unit": "°", "icon": "lucide:thermometer" },
          { "field": "wind", "label": "mWind", "unit": "", "icon": "lucide:wind" },
          { "field": "rain", "label": "mRain", "unit": "%", "icon": "lucide:droplet" }
        ]
      },
      "strip": {
        "from": "hourly",
        "label": "stripLabel",
        "time": "time",
        "value": "temp",
        "unit": "°",
        "icon": "wicon",
        "curve": true
      },
      "days": {
        "label": "daysLabel",
        "day": "day",
        "weekday": true,
        "hi": "hi",
        "lo": "lo",
        "unit": "°",
        "icon": "wicon",
        "prob": "prob",
        "bar": true
      }
    },
    {
      "id": "me",
      "type": "profile",
      "icon": "lucide:user",
      "label": "tabMe",
      "titleKey": "tabMe"
    }
  ],
  "profile": {
    "icon": "lucide:cloud-sun",
    "theme": true,
    "lang": true,
    "install": true,
    "source": {
      "label": "profSource",
      "url": "https://open-meteo.com/",
      "icon": "lucide:database"
    }
  }
}
