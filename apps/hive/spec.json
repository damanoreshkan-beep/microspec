{
  "id": "hive",
  "theme": "signal",
  "category": "tools",
  "accent": "#D9548E",
  "filters": {
    "defaults": {
      "kinds": [
        "ble",
        "wifi",
        "lte"
      ],
      "sort": "signal"
    },
    "controls": [
      {
        "type": "multi",
        "key": "kinds",
        "label": "fKinds",
        "icon": "lucide:radio",
        "options": [
          [
            "ble",
            "kBle"
          ],
          [
            "wifi",
            "kWifi"
          ],
          [
            "lte",
            "kLte"
          ]
        ]
      },
      {
        "type": "segment",
        "key": "sort",
        "label": "fSort",
        "icon": "lucide:arrow-down-up",
        "chip": true,
        "options": [
          [
            "seen",
            "sSeen"
          ],
          [
            "signal",
            "sSignal"
          ],
          [
            "kind",
            "sKind"
          ]
        ]
      }
    ]
  },
  "tabs": [
    {
      "id": "hive",
      "type": "tool",
      "icon": "lucide:hexagon",
      "label": "tabHive",
      "view": "hiveView",
      "fit": true,
      "needs": [
        "compass",
        "geo",
        "orientation",
        "wakeLock"
      ]
    },
    {
      "id": "list",
      "type": "tool",
      "icon": "lucide:list",
      "label": "tabList",
      "view": "listView"
    },
    {
      "id": "hunt",
      "type": "tool",
      "icon": "lucide:crosshair",
      "label": "tabHunt",
      "view": "huntView",
      "fit": true
    },
    {
      "id": "guard",
      "type": "tool",
      "icon": "lucide:shield-alert",
      "label": "tabGuard",
      "view": "guardView"
    },
    {
      "id": "me",
      "type": "profile",
      "icon": "lucide:settings",
      "label": "tabMe",
      "titleKey": "tabMe"
    }
  ],
  "profile": {
    "icon": "lucide:hexagon",
    "theme": true,
    "lang": true,
    "install": true,
    "permissions": [
      "ble",
      "wifi",
      "cell",
      "geolocation",
      "motion",
      "notifications"
    ]
  }
}
